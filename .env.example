# SETUP INSTRUCTIONS
# ─────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Open .env and fill in your real credentials
# 3. .env is gitignored — safe to store real values
# 4. Never rename .env.example or add real values to it
# 5. For Netlify/GitHub Actions production deployment:
#    Add each key below as a secret/environment variable
#    in the deploy platform, then pass it through as a
#    VITE_-prefixed build-time env var.
# ─────────────────────────────────────────────────────

VITE_PAYFAST_MERCHANT_ID=YOUR_MERCHANT_ID
VITE_PAYFAST_MERCHANT_KEY=YOUR_MERCHANT_KEY
VITE_PAYFAST_PASSPHRASE=YOUR_PASSPHRASE
VITE_PAYFAST_URL=https://sandbox.payfast.co.za/eng/process

VITE_EMAILJS_PUBLIC_KEY=YOUR_EMAILJS_PUBLIC_KEY
VITE_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID
VITE_EMAILJS_OWNER_TEMPLATE=YOUR_OWNER_TEMPLATE_ID
VITE_EMAILJS_CUSTOMER_TEMPLATE=YOUR_CUSTOMER_TEMPLATE_ID

VITE_STORE_OWNER_EMAIL=your@email.com
VITE_DELIVERY_FEE=60

VITE_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
